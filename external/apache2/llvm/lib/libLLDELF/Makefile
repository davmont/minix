#	MINIX 3: lld's ELF linker.  Only the ELF flavour is built -- we have no
#	use for COFF, Mach-O or WebAssembly.

LIB=	LLDELF

.include <bsd.init.mk>

.PATH: ${LLD_SRCDIR}/ELF
.PATH: ${LLD_SRCDIR}/ELF/Arch

SRCS+=	AArch64ErrataFix.cpp \
	ARMErrataFix.cpp \
	BPSectionOrderer.cpp \
	CallGraphSort.cpp \
	DWARF.cpp \
	Driver.cpp \
	DriverUtils.cpp \
	EhFrame.cpp \
	ICF.cpp \
	InputFiles.cpp \
	InputSection.cpp \
	LTO.cpp \
	LinkerScript.cpp \
	MapFile.cpp \
	MarkLive.cpp \
	OutputSections.cpp \
	Relocations.cpp \
	ScriptLexer.cpp \
	ScriptParser.cpp \
	SymbolTable.cpp \
	Symbols.cpp \
	SyntheticSections.cpp \
	Target.cpp \
	Thunks.cpp \
	Writer.cpp

# The per-architecture relocation handlers.  These are self-contained -- they
# do not pull in the LLVM target back-ends -- so building them all costs little
# and keeps lld able to link for any target the tree might grow.
SRCS+=	AArch64.cpp \
	AMDGPU.cpp \
	ARM.cpp \
	AVR.cpp \
	Hexagon.cpp \
	LoongArch.cpp \
	MSP430.cpp \
	Mips.cpp \
	MipsArchTree.cpp \
	PPC.cpp \
	PPC64.cpp \
	RISCV.cpp \
	SPARCV9.cpp \
	SystemZ.cpp \
	X86.cpp \
	X86_64.cpp

TABLEGEN_SRC=		Options.td
TABLEGEN_OUTPUT= \
	Options.inc|-gen-opt-parser-defs

.include "${.PARSEDIR}/../../tablegen.mk"

# Version.h includes "lld/Common/Version.inc", and Version.cpp includes
# "VCSVersion.inc" by bare name; both are generated by CMake upstream and
# curated here.  They live in lldconfig/, NOT config/: putting config/ on the
# include path would also put its llvm/Config/ on the path, shadowing the
# *generated* LLVM config headers and pulling in a static abi-breaking.h whose
# llvm-config.h does not exist there ("fatal error: llvm/Config/llvm-config.h").
CPPFLAGS+=	-I${LLVM_TOPLEVEL}/lldconfig \
		-I${LLVM_TOPLEVEL}/lldconfig/lld/Common \
		-I${LLD_SRCDIR}/ELF

.if defined(HOSTLIB)
.include <bsd.hostlib.mk>
.else
.include <bsd.lib.mk>
.endif
