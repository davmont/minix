#	MINIX 3: lld's common support library.

LIB=	LLDCommon

.include <bsd.init.mk>

.PATH: ${LLD_SRCDIR}/Common

SRCS+=	Args.cpp \
	CommonLinkerContext.cpp \
	DWARF.cpp \
	DriverDispatcher.cpp \
	ErrorHandler.cpp \
	Filesystem.cpp \
	Memory.cpp \
	Reproduce.cpp \
	Strings.cpp \
	TargetOptionsCommandFlags.cpp \
	Timer.cpp \
	Utils.cpp \
	Version.cpp

# Version.cpp includes "VCSVersion.inc" by plain name, and Version.h includes
# lld/Common/Version.inc; both are generated by CMake upstream and curated in
# ../../config/lld.
# Version.h includes "lld/Common/Version.inc" (so config/ must be on the path)
# and Version.cpp includes "VCSVersion.inc" by bare name (so config/lld/Common
# must be too).  Both are generated by CMake upstream; ours are curated.
CPPFLAGS+=	-I${LLVM_TOPLEVEL}/config \
		-I${LLVM_TOPLEVEL}/config/lld/Common

.if defined(HOSTLIB)
.include <bsd.hostlib.mk>
.else
.include <bsd.lib.mk>
.endif
