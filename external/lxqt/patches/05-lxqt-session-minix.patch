+# MINIX: bring up the compositor ourselves.
+#
+# Everywhere else startlxqt is launched from a display manager, or from a
+# compositor that is already running -- so it only ever has to set up the
+# environment.  MINIX has neither: you log in on a text console, and nothing has
+# opened the framebuffer.  wlcompd is our compositor, and it has to exist before
+# lxqt-session (a Wayland client itself) tries to connect.
+if [ -z "$WAYLAND_DISPLAY" ] && command -v wlcompd >/dev/null 2>&1; then
+    export WAYLAND_DISPLAY=wayland-0
+
+    if [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
+        # The framebuffer driver is not up on a text-console boot.
+        minix-service up /service/fb -dev /dev/fb0 >/dev/null 2>&1
+
+        wlcompd > "$XDG_RUNTIME_DIR/wlcompd.log" 2>&1 &
+
+        # Wait for the socket: everything after this connects to it, and a client
+        # that starts first just fails.
+        i=0
+        while [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && [ "$i" -lt 30 ]; do
+            sleep 1
+            i=$((i + 1))
+        done
+        if [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
+            echo "startlxqt: wlcompd did not come up; see $XDG_RUNTIME_DIR/wlcompd.log" >&2
