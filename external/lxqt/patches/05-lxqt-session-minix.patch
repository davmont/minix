+# A private, 0700 runtime dir, set up before anything that needs it (the D-Bus
+# socket and the Wayland socket both live here).  There is no systemd here to
+# make /run/user/$UID, and $XDG_RUNTIME_DIR must not be world-writable: D-Bus
+# refuses to put its socket in a directory others can write, so /tmp (mode 1777)
+# will not do.
+if [ -z "$XDG_RUNTIME_DIR" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
+    XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
+    mkdir -p "$XDG_RUNTIME_DIR"
+    chmod 700 "$XDG_RUNTIME_DIR"
