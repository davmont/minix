+    # A persistent session bus.  dbus-launch --exit-with-session watches the X
+    # session and, with no X here, exits immediately -- taking the bus with it,
+    # so the session (and Qt's D-Bus, which the whole LXQt stack needs) could
+    # never connect.  Start dbus-daemon directly on a per-user socket instead;
+    # it stays up for the life of the session.
+    if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
+        dbus-daemon --session --address="unix:path=$XDG_RUNTIME_DIR/bus" --fork \
+            || echo "startlxqt: could not start dbus-daemon" >&2
