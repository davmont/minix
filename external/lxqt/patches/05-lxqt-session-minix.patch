@@ -0,0 +1,22 @@
+/*
+ * Static Qt plugin imports (MINIX).
+ *
+ * Qt is linked statically here -- a dynamically linked Qt segfaults before main()
+ * in ld.elf_so's dynamic TLS -- so its plugins are archives, not .so files it can
+ * dlopen.  A static plugin only exists if it is registered by hand, and
+ * lxqt-session is a plain add_executable(), so Qt's automatic import generation
+ * (which qt_add_executable() would do) never runs.  Without this the session dies
+ * at startup with "Could not find the Qt platform plugin wayland" -- which is
+ * exactly what happened the first time startlxqt got as far as running it.
+ */
+#include <QtPlugin>
+
+Q_IMPORT_PLUGIN(QWaylandIntegrationPlugin)   /* QPA platform: wayland */
+
+/* Icons and images: a session that cannot draw an icon is not much of one. */
+Q_IMPORT_PLUGIN(XdgIconEnginePlugin)
+Q_IMPORT_PLUGIN(QSvgIconPlugin)
+Q_IMPORT_PLUGIN(QSvgPlugin)
+Q_IMPORT_PLUGIN(QGifPlugin)
+Q_IMPORT_PLUGIN(QICOPlugin)
+Q_IMPORT_PLUGIN(QJpegPlugin)
