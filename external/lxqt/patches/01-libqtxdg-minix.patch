diff -urN /tmp/pr3/libqtxdg-4.4.0/src/xdgiconloader/xdgiconloader_p.h libqtxdg-4.4.0/src/xdgiconloader/xdgiconloader_p.h
--- /tmp/pr3/libqtxdg-4.4.0/src/xdgiconloader/xdgiconloader_p.h	2026-04-20 09:07:00.000000000 +0200
+++ libqtxdg-4.4.0/src/xdgiconloader/xdgiconloader_p.h	2026-07-14 12:04:38.254720872 +0200
@@ -34,6 +34,23 @@
 #ifndef XDGICONLOADER_P_H
 #define XDGICONLOADER_P_H
 
+/* MINIX: Qt must be linked statically here (a dynamically linked Qt segfaults
+ * before main() in ld.elf_so's dynamic TLS).  That turns a latent ODR violation
+ * into a hard link error: this icon loader is a fork of Qt's private
+ * qiconloader.cpp, and it re-implements the member functions of PixmapEntry and
+ * ScalableEntry -- classes *declared by Qt's own* private/qiconloader_p.h -- as
+ * well as defining its own QIconCacheGtkReader.  With a shared Qt each copy stays
+ * inside its own .so and nobody notices; with a static Qt both object files land
+ * in one link and the three classes are defined twice.
+ *
+ * Rename our copies before Qt's header is pulled in, so they become genuinely
+ * distinct types rather than second definitions of Qt's.  Nothing outside this
+ * fork refers to them.
+ */
+#define PixmapEntry         XdgPixmapEntry
+#define ScalableEntry       XdgScalableEntry
+#define QIconCacheGtkReader XdgIconCacheGtkReader
+
 #include <QtCore/qglobal.h>
 
 #ifndef QT_NO_ICON
