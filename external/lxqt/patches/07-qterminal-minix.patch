+# MINIX: Qt is static, so its plugins are archives that must be registered by hand
+# (qt_add_executable would do this; a plain add_executable does not).  See
+# src/minix_static_plugins.cpp -- without it qterminal aborts with "Could not find
+# the Qt platform plugin wayland".
+if(CMAKE_SYSTEM_NAME STREQUAL "Minix")
+    target_sources(${EXE_NAME} PRIVATE src/minix_static_plugins.cpp)
+    # A Q_IMPORT_PLUGIN only declares the registration symbol; the plugin archive
+    # must also be linked.  Qt6::Gui already pulls in the image + xdg-shell plugins,
+    # but not the QPA platform plugin or LayerShellQt's integration -- add those.
+    target_link_libraries(${EXE_NAME}
+        Qt6::QWaylandIntegrationPlugin
+        ${CMAKE_SYSROOT}/usr/lib/liblayer-shell.a
+    )
