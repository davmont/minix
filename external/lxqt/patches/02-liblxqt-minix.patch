-add_library(${LXQT_LIBRARY_NAME}
-    SHARED ${PUB_HDRS}
+# STATIC, not the default SHARED: Qt has to be linked statically on MINIX (a
+# dynamic Qt segfaults before main() in ld.elf_so's dynamic TLS).  A liblxqt.so
+# would link static Qt *into itself* while the application links static Qt too,
+# giving one process two copies of Qt's global state -- and the non-PIC archives
+# will not go into a shared object anyway.
+add_library(${LXQT_LIBRARY_NAME} STATIC
+    ${PUB_HDRS}
            ${SRCS}
            ${dbus_generated}
            ${UIS} ${MOCS}
