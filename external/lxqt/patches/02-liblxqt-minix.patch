+# Upstream guards every X11 bit with "NOT APPLE", i.e. it assumes every non-Mac
+# platform has X11.  MINIX has none at all (no xsrc), so give the guard a name
+# and turn it off here.  What it excludes -- lxqtscreensaver and the XScreenSaver
+# link -- is exactly the X11-only part; lxqtpowerproviders only compares
+# QGuiApplication::platformName() at runtime and needs no X11 headers.
+if (APPLE OR CMAKE_SYSTEM_NAME STREQUAL "Minix")
+    set(LXQT_HAS_X11 FALSE)
+else()
+    set(LXQT_HAS_X11 TRUE)
+endif()
+
