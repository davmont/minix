--- a/lxqt-about-2.4.0/minix_static_plugins.cpp	2026-09-20 09:50:12.943451280 +0200
+++ b/lxqt-about-2.4.0/minix_static_plugins.cpp	2026-09-21 21:16:59.181236178 +0200
@@ -0,0 +1,13 @@
+/*
+ * Static Qt plugin imports (MINIX).
+ *
+ * Qt is linked statically here, so its plugins are archives, not .so files it can
+ * dlopen.  A plain add_executable() gets no automatic import generation, so the
+ * QPA platform plugin must be registered by hand -- otherwise the app aborts with
+ * "Could not find the Qt platform plugin wayland".  The image/icon plugins are
+ * pulled in automatically when linking Qt6::Gui, so only the platform plugin is
+ * imported here (re-importing the others would duplicate their symbols).
+ */
+#include <QtPlugin>
+
+Q_IMPORT_PLUGIN(QWaylandIntegrationPlugin)             /* QPA platform: wayland */
