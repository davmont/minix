--- a/lxqt-config-2.4.0/src/minix_static_plugins.cpp	2026-09-20 09:50:12.943451280 +0200
+++ b/lxqt-config-2.4.0/src/minix_static_plugins.cpp	2026-09-21 21:20:43.102338748 +0200
@@ -0,0 +1,8 @@
+/*
+ * Static Qt plugin imports (MINIX): register the wayland QPA platform plugin by
+ * hand, since a plain add_executable() with a static Qt gets no auto-import and
+ * would abort with "Could not find the Qt platform plugin wayland".
+ */
+#include <QtPlugin>
+
+Q_IMPORT_PLUGIN(QWaylandIntegrationPlugin)
