@@ -126,7 +126,9 @@
 
 set(${PROJECT_NAME}_PKG_CONFIG_REQUIRES "Qt6Widgets, Qt6DBus, ${LXQT_GLOBALKEYS_LIBRARY}")
 
-add_library(${PROJECT_NAME} SHARED ${${PROJECT_NAME}_ALL_FILES})
+# STATIC: Qt must be linked statically on MINIX, so everything downstream must
+# be too -- and the non-PIC Qt/freetype archives cannot go into a shared object.
+add_library(${PROJECT_NAME} STATIC ${${PROJECT_NAME}_ALL_FILES})
 target_link_libraries(${PROJECT_NAME}
     PUBLIC
         Qt6::Widgets
