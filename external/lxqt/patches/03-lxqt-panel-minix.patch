+++ lxqt-panel-2.4.1/panel/kx11extras_minix.h	2026-07-28 22:45:56.197051600 +0200
@@ -0,0 +1,30 @@
+/*
+ * MINIX: KWindowSystem is built without X11 support (there is no X11 here at
+ * all), so KX11Extras does not exist.  Every use of it in the panel is an
+ * X11/EWMH operation -- _NET_WM_STRUT, _NET_WM_WINDOW_TYPE_DOCK, virtual
+ * desktops, window activation -- and none of them apply on Wayland, where
+ * LayerShellQt sets the layer, the anchors and the exclusive zone instead.  The
+ * call sites that are not already guarded by a QX11Application check are
+ * unreachable without X11 anyway.
+ *
+ * So give them a no-op stub rather than #ifdef out a dozen call sites.  The
+ * members are variadic templates purely so the stub does not have to track
+ * upstream's exact signatures.
+ */
+#ifndef KX11EXTRAS_MINIX_H
+#define KX11EXTRAS_MINIX_H
+
+#include <netwm_def.h>
+
+struct KX11Extras
+{
+    template <typename... A> static void activateWindow(A &&...) {}
+    template <typename... A> static void setOnDesktop(A &&...) {}
+    template <typename... A> static void setOnAllDesktops(A &&...) {}
+    template <typename... A> static void setType(A &&...) {}
+    template <typename... A> static void setExtendedStrut(A &&...) {}
+    template <typename... A> static void setDesktopName(A &&...) {}
+    static int currentDesktop() { return 0; }
+};
+
+#endif /* KX11EXTRAS_MINIX_H */
