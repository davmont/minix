+# Upstream loads the WM backends at runtime as .so plugins (LXQtPanelApplication
+# scans the backend dir for *.so).  A static binary cannot dlopen, and Qt must be
+# static on MINIX -- so on MINIX we build exactly one backend, statically, and
+# LXQtPanelApplication uses it directly.
+#
+# It is the wlroots one, because wlcompd implements the protocol it speaks:
+# wlr-foreign-toplevel-management-v1, which is the only way Wayland lets a panel
+# see other clients' windows at all.  The others are unusable here on their own
+# terms: xcb needs X11, kwin_wayland needs KWin's private protocols, wayfire its
+# own.
+if (CMAKE_SYSTEM_NAME STREQUAL "Minix")
+    add_subdirectory(wayland/wlroots)
+else()
+    add_subdirectory(wayland)
+    add_subdirectory(xcb)
+endif()
