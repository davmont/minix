diff -urN /tmp/pr/lxqt-panel-2.4.1/panel/minix_static_plugins.cpp lxqt-panel-2.4.1/panel/minix_static_plugins.cpp
--- /tmp/pr/lxqt-panel-2.4.1/panel/minix_static_plugins.cpp	1970-01-01 01:00:00.000000000 +0100
+++ lxqt-panel-2.4.1/panel/minix_static_plugins.cpp	2026-07-14 17:02:55.980280066 +0200
@@ -0,0 +1,26 @@
+/*
+ * Static Qt plugin imports (MINIX).
+ *
+ * Qt has to be linked statically here -- a dynamically linked Qt segfaults before
+ * main() in ld.elf_so's dynamic TLS -- which means Qt's plugins are archives, not
+ * .so files it can dlopen.  A static plugin only exists if it is registered by
+ * hand, and lxqt-panel is a plain add_executable(), so Qt's own automatic import
+ * generation (which qt_add_executable() would do) never runs.  Without this the
+ * panel aborts at startup with "Could not find the Qt platform plugin wayland".
+ *
+ * The same applies to LayerShellQt: its wlr-layer-shell support IS a QPA
+ * shell-integration plugin, selected by QT_WAYLAND_SHELL_INTEGRATION=layer-shell.
+ * Importing it is what lets LayerShellQt::Window actually dock the panel.
+ */
+#include <QtPlugin>
+
+Q_IMPORT_PLUGIN(QWaylandIntegrationPlugin)             /* QPA platform: wayland */
+Q_IMPORT_PLUGIN(QWaylandLayerShellIntegrationPlugin)   /* wlr-layer-shell */
+
+/* Icons and images: the panel is unusable without them. */
+Q_IMPORT_PLUGIN(XdgIconEnginePlugin)                   /* libqtxdg icon engine */
+Q_IMPORT_PLUGIN(QSvgIconPlugin)
+Q_IMPORT_PLUGIN(QSvgPlugin)
+Q_IMPORT_PLUGIN(QGifPlugin)
+Q_IMPORT_PLUGIN(QICOPlugin)
+Q_IMPORT_PLUGIN(QJpegPlugin)
