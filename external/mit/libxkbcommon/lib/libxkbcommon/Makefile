#	MINIX: libxkbcommon
#
# Wayland's keyboard handling lives here: the compositor sends a keymap over
# wl_keyboard.keymap as XKB text, and every client compiles it with
# xkb_keymap_new_from_string() and tracks modifiers with xkb_state.
#
# Note what that means for the XKB data files: a *client* never needs them --
# it is handed the keymap on the wire.  Only whoever generates a keymap
# (xkb_keymap_new_from_names()) needs xkeyboard-config under
# DFLT_XKB_CONFIG_ROOT, and that is not vendored here.  MINIX ships one
# precompiled keymap instead (see ../../keymap), which is what a compositor
# sends.
#
# The X11 backend (src/x11, needs xcb) and the registry (needs libxml2) are not
# built.

.include <bsd.init.mk>

LIB=		xkbcommon

# NB: src/compose is deliberately NOT on .PATH.  It contains its own parser.h
# and parser.c, which bmake would resolve the bison targets to -- declaring
# parser.h "up to date" and never running bison at all.  Every compose file is
# reached through a forwarder instead.
.PATH:	${XKBSRCDIR}/src ${XKBSRCDIR}/src/xkbcomp

SRCS=		atom.c context.c context-priv.c keysym.c keysym-utf.c \
		keymap.c keymap-priv.c state.c text.c utf8.c utils.c \
		util-list.c

# The XKB compiler.  xkbcomp/keymap.c collides by basename with src/keymap.c,
# and bsd.lib.mk names objects after the basename, so it is compiled through a
# generated forwarder (below).  The rest are unambiguous.
SRCS+=		action.c ast-build.c compat.c expr.c include.c keycodes.c \
		keymap-dump.c keywords.c rules.c scanner.c symbols.c types.c \
		vmod.c xkbcomp.c
SRCS+=		xkbcomp-keymap.c

# Compose (dead-key sequences); all via forwarders, see the .PATH note above.
SRCS+=		compose-parser.c compose-paths.c compose-state.c compose-table.c

# Generated by bison.
SRCS+=		parser.c

CPPFLAGS+=	-I${.OBJDIR}
CPPFLAGS+=	-I${XKBMINIXDIR}		# config.h
CPPFLAGS+=	-I${XKBSRCDIR} -I${XKBSRCDIR}/src -I${XKBSRCDIR}/include

# Paths meson would normally bake in.
#
# DFLT_XKB_CONFIG_ROOT points at /usr/share/xkb -- the directory we actually
# ship -- and NOT at the conventional /usr/share/X11/xkb, which does not exist
# here.  That matters more than it looks: xkb_context_new() *fails outright*
# (returns NULL) if it cannot add its default include path, so a non-existent
# root would break every caller before it got anywhere near a keymap.
#
# The directory holds a compiled keymap rather than an xkeyboard-config tree,
# so xkb_keymap_new_from_names() still cannot compile a keymap from rules --
# by design; see the note at the top.
CPPFLAGS+=	-DDFLT_XKB_CONFIG_ROOT='"/usr/share/xkb"'
CPPFLAGS+=	-DDFLT_XKB_CONFIG_EXTRA_PATH='"/etc/xkb"'
CPPFLAGS+=	-DXLOCALEDIR='"/usr/share/X11/locale"'
CPPFLAGS+=	-DDEFAULT_XKB_RULES='"evdev"'
CPPFLAGS+=	-DDEFAULT_XKB_MODEL='"pc105"'
CPPFLAGS+=	-DDEFAULT_XKB_LAYOUT='"us"'
CPPFLAGS+=	-DDEFAULT_XKB_VARIANT=NULL
CPPFLAGS+=	-DDEFAULT_XKB_OPTIONS=NULL

COPTS+=		-Wno-error
COPTS+=		-Wno-unknown-warning-option

INCS=		xkbcommon.h xkbcommon-names.h xkbcommon-keysyms.h \
		xkbcommon-compose.h xkbcommon-compat.h
INCSDIR=	/usr/include/xkbcommon
.PATH:		${XKBSRCDIR}/include/xkbcommon

#
# src/xkbcomp/parser.y uses bison-specific directives (%define api.pure), which
# the tree's nbyacc rejects, so it is generated with the host's bison -- the
# same arrangement as wayland-scanner, which is built with ${HOST_CC}.
#
TOOL_BISON?=	bison

XKB_PARSER_C=	parser.c
XKB_PARSER_H=	parser.h

XKB_FWD=	xkbcomp-keymap.c compose-parser.c compose-paths.c \
		compose-state.c compose-table.c

CLEANFILES+=	${XKB_PARSER_C} ${XKB_PARSER_H} ${XKB_FWD}

${XKB_PARSER_C} ${XKB_PARSER_H}: ${XKBSRCDIR}/src/xkbcomp/parser.y
	${_MKTARGET_CREATE}
	${TOOL_BISON} -d -p _xkbcommon_ \
		--defines=${XKB_PARSER_H} -o ${XKB_PARSER_C} ${.ALLSRC}

# Forwarders for the three basenames that appear in two directories.  The
# #include resolves through -I${XKBSRCDIR}/src.
xkbcomp-keymap.c:
	${_MKTARGET_CREATE}
	echo '#include "xkbcomp/keymap.c"' > ${.TARGET}

compose-parser.c:
	${_MKTARGET_CREATE}
	echo '#include "compose/parser.c"' > ${.TARGET}

compose-state.c:
	${_MKTARGET_CREATE}
	echo '#include "compose/state.c"' > ${.TARGET}

compose-paths.c:
	${_MKTARGET_CREATE}
	echo '#include "compose/paths.c"' > ${.TARGET}

compose-table.c:
	${_MKTARGET_CREATE}
	echo '#include "compose/table.c"' > ${.TARGET}

DPSRCS+=	${XKB_PARSER_C} ${XKB_PARSER_H} ${XKB_FWD}

FILES+=			xkbcommon.pc
FILESDIR_xkbcommon.pc=	/usr/lib/pkgconfig
CLEANFILES+=		xkbcommon.pc

xkbcommon.pc: xkbcommon.pc.in
	${_MKTARGET_CREATE}
	${TOOL_SED} -e 's/@VERSION@/${XKB_VERSION}/g' \
		< ${.CURDIR}/xkbcommon.pc.in > ${.TARGET}

all: ${XKB_PARSER_C} ${XKB_FWD} xkbcommon.pc
dependall: all

.include <bsd.lib.mk>

# Every translation unit reaches parser.h (xkbcomp/parser-priv.h includes it),
# so the bison run has to happen before any of them compile.  DPSRCS does not
# order that under -j, and OBJS/SOBJS/POBJS only exist once bsd.lib.mk has been
# read -- hence this sits after the include.
${OBJS} ${SOBJS} ${POBJS}: ${XKB_PARSER_H} ${XKB_FWD}

# ...and the same holds one stage earlier, for the per-file .d dependency
# generation: mkdep reads the same #includes, so it too fails if bison has not
# run yet.  That stage does not consult DPSRCS either.
.for _f in ${SRCS:M*.c:T:R}
${_f}.d: ${XKB_PARSER_H} ${XKB_FWD}
.endfor
