#	MINIX: libwayland-server
#
# event-loop.c is compiled UNMODIFIED against the private epoll/timerfd/
# signalfd/eventfd emulation in ../../minix (see minix/include/sys/epoll.h for
# why that shim exists and the one thing it cannot do).  wl-compat-poll.c is
# that emulation.

.include <bsd.init.mk>

LIB=		wayland-server

.PATH:	${WLSRCDIR}/src ${WLMINIXDIR}

SRCS=		wayland-server.c wayland-shm.c event-loop.c \
		connection.c wayland-util.c wayland-os.c \
		wl-compat-poll.c

# Generated by wayland-scanner from protocol/wayland.xml, into ${.OBJDIR}.
# Name it by its absolute path: the rule in wayland-gen.mk targets the absolute
# path, and a bare "wayland-protocol.c" is a different node to bmake -- it would
# be resolved through .PATH against the source tree instead, which is how a stale
# checked-in copy used to shadow the generated one and quietly make wayland.xml
# not the source of truth at all.
SRCS+=		${WL_PROTO_C}

.include "${WLDIR}/lib/wayland-gen.mk"

DPSRCS+=	${WL_VERSION_H} ${WL_SERVER_H} ${WL_PROTO_C}

INCS=		wayland-server.h wayland-server-core.h wayland-util.h \
		wayland-version.h wayland-server-protocol.h
INCSDIR=	/usr/include

FILES+=			wayland-server.pc
FILESDIR_wayland-server.pc=	/usr/lib/pkgconfig
CLEANFILES+=		wayland-server.pc

wayland-server.pc: wayland-server.pc.in
	${_MKTARGET_CREATE}
	${TOOL_SED} -e 's/@VERSION@/${WAYLAND_VERSION}/g' \
		< ${.CURDIR}/wayland-server.pc.in > ${.TARGET}

all: ${WL_VERSION_H} ${WL_SERVER_H} ${WL_PROTO_C} wayland-server.pc
dependall: all

# A shared library must record what it needs.  libwayland dispatches every
# protocol message through ffi_call(), so libffi is a real dependency -- without
# this the .so has undefined ffi_* symbols and anything that links it fails,
# which is exactly how Qt's Wayland plugin first failed to link.
LIBDPLIBS+=	ffi	${.CURDIR}/../../../libffi/lib/libffi

# INCS lists the generated protocol and version headers, but two things stop
# the "includes" phase of a full build from getting them:
#
#  - it runs before "dependall", which is what generates them; and
#  - the generating rules name their targets by ABSOLUTE path (see
#    wayland-gen.mk, which does that deliberately so -j does not race), while
#    INCS refers to them by bare name -- and to bmake those are different nodes.
#
# So bmake reaches the install-includes step with no rule to make the bare name
# ("don't know how to make wayland-server-protocol.h") and the build stops.  Bridge the
# bare names to the absolute targets, and make the includes phase depend on them.
wayland-server-protocol.h: ${WL_VERSION_H} ${WL_SERVER_H}
wayland-version.h: ${WL_VERSION_H}
includes: ${WL_VERSION_H} ${WL_SERVER_H}

.include <bsd.lib.mk>
