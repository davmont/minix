#	MINIX: libwayland-client
#
# The client library does not use the event loop (it polls its display fd
# directly), but it shares wayland-os.c, which references epoll_create1() and
# the close(2) redirect -- so the same compat object is linked in here.

.include <bsd.init.mk>

LIB=		wayland-client

.PATH:	${WLSRCDIR}/src ${WLMINIXDIR}

SRCS=		wayland-client.c connection.c wayland-util.c wayland-os.c \
		wl-compat-poll.c

# Generated by wayland-scanner.
SRCS+=		wayland-protocol.c

.include "${WLDIR}/lib/wayland-gen.mk"

DPSRCS+=	${WL_VERSION_H} ${WL_CLIENT_H} ${WL_PROTO_C}

INCS=		wayland-client.h wayland-client-core.h wayland-util.h \
		wayland-version.h wayland-client-protocol.h
INCSDIR=	/usr/include

FILES+=			wayland-client.pc
FILESDIR_wayland-client.pc=	/usr/lib/pkgconfig
CLEANFILES+=		wayland-client.pc

wayland-client.pc: wayland-client.pc.in
	${_MKTARGET_CREATE}
	${TOOL_SED} -e 's/@VERSION@/${WAYLAND_VERSION}/g' \
		< ${.CURDIR}/wayland-client.pc.in > ${.TARGET}

all: ${WL_VERSION_H} ${WL_CLIENT_H} ${WL_PROTO_C} wayland-client.pc
dependall: all

.include <bsd.lib.mk>
