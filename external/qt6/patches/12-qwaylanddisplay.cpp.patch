 // We have to wait until we have an eventDispatcher before creating the eventThread,
 // otherwise forceRoundTrip() may block inside _events_read() because eventThread is
 // polling.
+// MINIX: keep the Wayland event-reader threads quiescent across fork().
+//
+// qtwayland uses a split reader: the main thread calls wl_display_prepare_read()
+// and an EventThread poll()s and calls wl_display_read_events().  A fork() (as
+// QProcess::startDetached() does to launch a program) can catch that machinery
+// mid-read.  The child exec()s immediately and is fine, but the *parent* is then
+// left unable to create new Wayland surfaces -- concretely, the LXQt panel's
+// start menu never re-appears after launching an app, because get_layer_surface
+// requests never reach the compositor.  Stopping both reader threads before the
+// fork and recreating them afterwards leaves wl_display in a clean state on the
+// parent side.  (fork() rather than vfork() is forced on MINIX in
+// qprocess_unix.cpp so that these handlers actually run.)
+static QWaylandDisplay *s_forkDisplay = nullptr;
+static bool s_inForkChild = false;
+
+void QWaylandDisplay::quiesceEventThreadsForFork()
+{
+    if (m_eventThread)
+        m_eventThread->stop();
+    if (m_frameEventQueueThread)
+        m_frameEventQueueThread->stop();
+}
+
+void QWaylandDisplay::resumeEventThreadsAfterFork()
+{
+    m_eventThread.reset(
+            new EventThread(mDisplay, /* default queue */ nullptr, EventThread::EmitToDispatch));
+    connect(m_eventThread.get(), &EventThread::needReadAndDispatch, this,
+            &QWaylandDisplay::flushRequests, Qt::QueuedConnection);
+    connect(m_eventThread.get(), &EventThread::waylandError, this,
+            &QWaylandDisplay::checkWaylandError, Qt::QueuedConnection);
+    m_eventThread->start();
+
+    // The frame event queue itself still exists; only its reader thread stopped.
+    if (m_frameEventQueue) {
+        m_frameEventQueueThread.reset(
+                new EventThread(mDisplay, m_frameEventQueue, EventThread::SelfDispatch));
+        m_frameEventQueueThread->start();
+    }
+}
+
+static void qwl_fork_prepare()
+{
+    if (s_forkDisplay && !s_inForkChild)
+        s_forkDisplay->quiesceEventThreadsForFork();
+}
+static void qwl_fork_parent()
+{
+    if (s_forkDisplay && !s_inForkChild)
+        s_forkDisplay->resumeEventThreadsAfterFork();
+}
+static void qwl_fork_child()
+{
+    // This process is about to exec() (or _exit()); don't touch the threads, and
+    // make any fork() it does itself a no-op for these handlers.
+    s_inForkChild = true;
+}
