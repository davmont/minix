@@ -11,6 +11,10 @@
 #include <QtCore/qdebug.h>
 #include <QtCore/qstandardpaths.h>
 #include <QtCore/qtemporaryfile.h>
+#if defined(Q_OS_MINIX)
+#  include <QtCore/qatomic.h>
+#  include <fcntl.h>
+#endif
 #include <QtGui/QPainter>
 #include <QtGui/QTransform>
 #include <QMutexLocker>
@@ -62,6 +66,33 @@
     fd = syscall(SYS_memfd_create, "wayland-shm", MFD_CLOEXEC | MFD_ALLOW_SEALING);
     if (fd >= 0)
         fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_SEAL);
+#elif defined(Q_OS_MINIX)
+    /*
+     * MINIX has no memfd_create.  The fallback below, a QTemporaryFile, would
+     * put the pool in a file on disk -- in $XDG_RUNTIME_DIR or /tmp, wherever
+     * that is mounted -- and every frame painted into it would be written out.
+     *
+     * POSIX shared memory is a file in the tmpfs on /var/shm: its pages are
+     * in memory only, and a MAP_SHARED mapping of it, here and in the
+     * compositor, maps those very pages.  That is precisely the buffer wl_shm
+     * needs, so create the pool with shm_open().
+     *
+     * The name is unlinked immediately and only the descriptor kept -- the
+     * ordinary anonymous-pool idiom, and the same one libwayland's own clients
+     * use.
+     *
+     * Growing the pool is ftruncate() and a new mmap(), as for any file.
+     */
+    {
+        static QBasicAtomicInt counter = Q_BASIC_ATOMIC_INITIALIZER(0);
+        char name[64];
+
+        snprintf(name, sizeof(name), "/qtwl-%d-%d", int(getpid()),
+                 counter.fetchAndAddRelaxed(1));
+        fd = shm_open(name, O_RDWR | O_CREAT | O_EXCL, 0600);
+        if (fd >= 0)
+            shm_unlink(name);
+    }
 #endif
 
     std::unique_ptr<QFile> filePointer;
