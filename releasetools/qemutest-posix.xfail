interfaces/pthread_cond_timedwait/2-3                    # unresolved
interfaces/pthread_cond_timedwait/2-6                    # nobuild
interfaces/pthread_cond_timedwait/4-2                    # nobuild
interfaces/pthread_cond_timedwait/4-3                    # timeout

