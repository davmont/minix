# Known failures of the Open POSIX Test Suite on amd64, for
# releasetools/qemutest.py --suite posix --xfail.  Same format as
# qemutest.xfail.  Baseline taken 2026-10-21 on 2 CPUs: 1287 of 1757 tests pass,
# 30 skip (UNSUPPORTED/UNTESTED).  The verdict after each test is what it
# gave then: nobuild (does not compile: the interface or a definition is
# missing), fail, unresolved (the test could not set itself up), timeout,
# signal, wedge (took the system down).  Remove a test here in the change
# that fixes it; XPASS fails the run.

# interfaces/aio_cancel
interfaces/aio_cancel/3-1                                flaky  # timing: UNRESOLVED when every write is done before aio_cancel()
interfaces/aio_cancel/6-1                                flaky  # timing: the same, by the test's design

# interfaces/aio_error
interfaces/aio_error/2-1                                 flaky  # timing: all 128 writes may be done before aio_error() looks

# interfaces/aio_suspend
interfaces/aio_suspend/1-1                               flaky  # timing: the 20 MB write may be done before aio_suspend()
interfaces/aio_suspend/4-1                               flaky  # timing: the same, after the suspend has timed out

# interfaces/clock
interfaces/clock/1-1                                     flaky  # timing: passed on 1 CPU, failed once on 2
interfaces/clock/2-1                                     # fail

# interfaces/clock_nanosleep
interfaces/clock_nanosleep/13-1                          # fail

# interfaces/clock_settime
interfaces/clock_settime/19-1                            # fail
interfaces/clock_settime/4-1                             # fail
interfaces/clock_settime/4-2                             # fail
interfaces/clock_settime/7-1                             # fail
interfaces/clock_settime/7-2                             # fail
interfaces/clock_settime/speculative/4-3                 # fail

# interfaces/fork
interfaces/fork/18-1                                     # unresolved

# interfaces/fsync
interfaces/fsync/7-1                                     # fail

# interfaces/killpg
interfaces/killpg/1-2                                    # nobuild

# interfaces/mlock
interfaces/mlock/5-1                                     # unresolved: mlock() of an unaligned malloc() buffer: EINVAL, as POSIX permits

# interfaces/mlockall
interfaces/mlockall/3-6                                  # fail: wants EBUSY from msync(MS_INVALIDATE) on locked pages; nothing is pinned
interfaces/mlockall/3-7                                  # fail: the same

# interfaces/mmap
interfaces/mmap/1-2                                      # fail
interfaces/mmap/11-3                                     # fail
interfaces/mmap/11-4                                     # fail
interfaces/mmap/13-1                                     # fail
interfaces/mmap/18-1                                     # fail: wants EAGAIN past RLIMIT_MEMLOCK after MCL_FUTURE; nothing is pinned
interfaces/mmap/24-1                                     flaky  # maps to ENOMEM in about the 60 s limit
interfaces/mmap/24-2                                     # signal
interfaces/mmap/7-4                                      # fail

# interfaces/mq_close
interfaces/mq_close/2-1                                  # fail

# interfaces/mq_timedreceive
interfaces/mq_timedreceive/5-1                           # fail

# interfaces/mq_timedsend
interfaces/mq_timedsend/5-1                              # fail
interfaces/mq_timedsend/5-2                              # fail

# interfaces/munlock
interfaces/munlock/7-1                                   # unresolved: munlock() of an unaligned malloc() buffer: EINVAL, as POSIX permits

# interfaces/munmap
interfaces/munmap/1-1                                    flaky  # signal or pass, both CPU counts

# interfaces/nanosleep
interfaces/nanosleep/2-1                                 # unresolved

# interfaces/pthread_atfork
interfaces/pthread_atfork/3-3                            # timeout

# interfaces/pthread_cond_broadcast
interfaces/pthread_cond_broadcast/1-2                    # nobuild
interfaces/pthread_cond_broadcast/2-3                    # nobuild
interfaces/pthread_cond_broadcast/4-2                    # unresolved

