interfaces/sched_setparam/27-1                           flaky  # timing: passed on 1 CPU, failed once on 2
interfaces/sched_setparam/25-2                           # nobuild
interfaces/sched_setparam/25-3                           # nobuild
interfaces/sched_setparam/25-4                           # nobuild
interfaces/sched_setparam/9-1                            # on 2 CPUs: the child reads its priority from PM after the parent has its reply

