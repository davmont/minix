: ${OBJ=../obj.${ARCH}}

# TOOLDIR is keyed on the host OS and architecture.  On non-Linux hosts the
# kernel release is part of the key too, because there it names the whole OS
# release (kernel and userland).  Must match TOOLDIR_OSTYPE in <bsd.host.mk>.
if [ "`uname -s`" = "Linux" ]
then
	_tooldir_ostype="`uname -s`-`uname -m`"
else
	_tooldir_ostype="`uname -s`-`uname -r`-`uname -m`"
fi
: ${CROSS_TOOLS=${OBJ}/"tooldir.${_tooldir_ostype}"/bin}
unset _tooldir_ostype

: ${CROSS_PREFIX=${CROSS_TOOLS}/${TOOLCHAIN_TRIPLET}}
: ${JOBS=1}
: ${DESTDIR=${OBJ}/destdir.$ARCH}
: ${RELEASEDIR=${OBJ}/releasedir/$ARCH/binary}
: ${RELEASETOOLSDIR=./releasetools/}
: ${BUILDVARS=}
: ${CREATE_IMAGE_ONLY=0}
: ${RELEASE_VERSION=$(sh sys/conf/osrelease.sh)}

: ${WORK_DIR=${OBJ}/work}
: ${SETS_DIR=${OBJ}/releasedir/${ARCH}/binary/sets}

: ${PACKAGE_DIR=}
: ${PKG_INFO=pkg_info}
: ${BUNDLE_PACKAGES=}

: ${BUNDLE_SETS=0}

: ${RC=../local/rc.${ARCH}}
: ${ASR_HACK=0}

# where the kernel & boot modules will be
MODDIR=${DESTDIR}/boot/minix/.temp
