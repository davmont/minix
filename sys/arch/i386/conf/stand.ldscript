/*	$NetBSD: stand.ldscript,v 1.5 2015/08/22 23:49:54 uebayasi Exp $	*/

/* OUTPUT_FORMAT intentionally omitted — different toolchains use
 * different BFD target names for i386 (`elf32-i386` for the amd64
 * cross-binutils, `elf32-i386-minix` for the native i386 binutils).
 * Both Makefile.booters etc. pass `-Wl,-m,elf_i386` which selects
 * the right output format from the linker's command line, making
 * the script-level OUTPUT_FORMAT redundant and a portability issue.
 */
OUTPUT_ARCH(i386)
ENTRY(_start)
SECTIONS
{
  /* Read-only sections, merged into text segment: */
  .text :
  {
    *(.text)
    *(.text.*)
    *(.stub)
  }
  _etext = . ;
  PROVIDE (etext = .) ;

  .rodata :
  {
    *(.rodata)
    *(.rodata.*)
  }

  __data_start = . ;
  .data :
  {
    *(.data)
  }
  .data.cacheline_aligned :
  {
    *(.data.cacheline_aligned)
  }
  .data.read_mostly :
  {
    *(.data.read_mostly)
  }
  _edata = . ;
  PROVIDE (edata = .) ;
  __bss_start = . ;
  .bss :
  {
    *(.bss)
    *(.bss.*)
    *(COMMON)
    . = ALIGN(32 / 8);
  }
  . = ALIGN(32 / 8);
  _end = . ;
  PROVIDE (end = .) ;
  /DISCARD/ : {
    *(.eh_frame_hdr)
    *(.eh_frame)
    *(.note.netbsd.ident)
  }
}
SECTIONS
{
  .text :
  AT (ADDR(.text) & 0x0fffffff)
  {
    *(.text)
  } =0
}
