# Additional build artifacts
a.out
boot/
*.map
*.sym
vers.c
# Generated architecture symlink directories.
#
# These MUST be anchored.  As bare patterns ("i386", "machine", "x86") they
# matched a directory of that name ANYWHERE in the tree, which silently swallowed
# real source directories on import -- external/mit/libffi/dist/src/x86/ was lost
# that way, and devel could not be built at all until it was restored.  The
# symlinks nbmake creates live at the top level and under sys/arch/*/stand
# (the latter are listed further down).
/machine
/i386
/x86
machines.lo.o

# Bootxx build artifacts
sys/arch/i386/stand/bootxx/bootxx*.o
sys/arch/i386/stand/bootxx/bootxx*.d
sys/arch/i386/stand/bootxx/bootxx_minixfs3/bootxx_minixfs3
sys/arch/i386/stand/bootxx/bootxx_minixfs3/bootxx_minixfs3.sym
sys/arch/i386/stand/bootxx/bootxx_minixfs3/bootxx_minixfs3.map
sys/arch/i386/stand/cdboot/cdboot

# BIOS boot artifacts
sys/arch/i386/stand/boot/biosboot/boot_monitor
sys/arch/i386/stand/boot/biosboot/boot_monitor.map
sys/arch/i386/stand/boot/biosboot/boot_monitor.sym
sys/arch/i386/stand/boot/biosboot/vers.c
sys/arch/i386/stand/cdboot/bootxx_cd9660

# nbmake creates machine/x86/i386 include-dir symlinks in-tree during cross-build
sys/arch/i386/stand/**/machine
sys/arch/i386/stand/**/x86
sys/arch/i386/stand/**/i386
boot/minix/.temp/kernel
boot/minix/.temp/mod01_ds
boot/minix/.temp/mod02_rs
boot/minix/.temp/mod03_pm
boot/minix/.temp/mod04_sched
boot/minix/.temp/mod05_vfs
boot/minix/.temp/mod06_memory
boot/minix/.temp/mod07_tty
boot/minix/.temp/mod08_mib
boot/minix/.temp/mod09_vm
boot/minix/.temp/mod10_pfs
boot/minix/.temp/mod11_mfs
boot/minix/.temp/mod12_init

# Locally-built release / boot media.  The releasetools/*image.sh scripts write
# these to the repo root; they are large artifacts and must never be committed.
# Blanket patterns (rather than per-name entries) so newly-named images are
# covered too.
/minix_*.iso
/minix_*.iso.bak
/minix_*.img

# build output from tools/llvm-lld (the host ld.lld binary)
tools/llvm-lld/*-ld.lld
