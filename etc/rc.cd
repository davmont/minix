#!/bin/sh

# CD boottime initializations.

# Diagnostic markers — gated on verbose=2+ in the kernel boot command line.
_rccd_verbose=$(sysenv verbose 2>/dev/null)
: ${_rccd_verbose:=0}
rcv() { [ "${_rccd_verbose:-0}" -ge 2 ] 2>/dev/null && echo "$@"; }

rcv "RCCD: enter, pid=$$, args=$@"
echo -n "Creating ramdisks:"

# Set up a ramdisk to make a read-only part of the directory tree writable
# $1 : ramdisk dev node to use
# $2 : path to make writeable
# $3 : ramdisk size in blocks
create_ramdisk()
{
	rcv "RCCD: create_ramdisk $1 $2 $3"
	echo -n " $2"
	ramdisk $3 /dev/$1 > /dev/null
	mkfs.mfs /dev/$1 > /dev/null

	# copy files
	rcv "RCCD:  about to mount /dev/$1 /mnt"
	mount /dev/$1 /mnt > /dev/null; r=$?
	rcv "RCCD:   mount /dev/$1 /mnt ret=$r"
	(cd $2 && pax -rw . /mnt)

	rcv "RCCD:  about to umount /mnt"
	umount /mnt > /dev/null; r=$?
	rcv "RCCD:   umount /mnt ret=$r"
	rcv "RCCD:  about to mount /dev/$1 $2"
	mount /dev/$1 $2 > /dev/null; r=$?
	rcv "RCCD:   mount /dev/$1 $2 ret=$r"
}

# Create /var ramdisk.  /var must hold both the existing services.cdb
# (~327 KB, copied from the installed /var on CD-mount) AND a fresh
# services.cdb.tmp written by services_mkdb at boot time, plus the rest
# of /var/run (utmp/utmpx, pids, sockets) and /var/db.  At 768 KB the
# temp write fails with ENOSPC, sysdb exits with code 2, and the boot
# log spams `services_mkdb: Error writing temporary database
# '/var/db/services.cdb.tmp': No space left on device`.  Bumped to
# 2048 KB for comfortable headroom.
if [ -x /usr/bin/startlxqt ]; then
	# Desktop (LXQt/Qt6) CD.  A Qt session writes its config to /root/.config
	# and font/icon/QML caches to /root/.cache, and uses /tmp and the runtime
	# dir for wayland/D-Bus sockets and wl_shm scratch.  The base sizes ENOSPC
	# mid-startup, and a truncated mmap'd cache then faults the session
	# ("No space on device" -> nopage read SIGSEGV in lxqt-session).  These are
	# RAM, so only grow them when the desktop is actually installed -- the base
	# CD still boots in its usual small footprint.
	create_ramdisk ram0 /var 8192
	create_ramdisk ram1 /tmp 65536
	create_ramdisk ram2 /usr/run 16384
	create_ramdisk ram3 /root 131072
else
	create_ramdisk ram0 /var 2048
	create_ramdisk ram1 /tmp 128
	create_ramdisk ram2 /usr/run 64
	create_ramdisk ram3 /root 512
fi

echo
