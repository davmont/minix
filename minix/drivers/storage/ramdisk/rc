#!/bin/sh
set -e

PATH=/sbin:/usr/sbin:/bin:/usr/bin

FSCK=/bin/fsck_mfs
ACPI=/service/acpi

# Diagnostic markers — gated on verbose=2+ in the kernel boot command line.
# Defined here (before the per-arch blocks) so they can be used uniformly.
#
# `sysenv verbose` exits non-zero when the verbose env var is not set on
# the kernel command line (e.g. boot menu option 1).  Under `set -e` the
# non-zero exit of the command substitution would otherwise kill the
# script before it ever reaches the per-arch blocks.  Default to 0 on
# any failure.
_rdrc_verbose=$(sysenv verbose 2>/dev/null || echo 0)
: ${_rdrc_verbose:=0}
rdrcv() {
	# Print only when kernel verbose level >= 2.  Implemented as a case
	# expression on the literal verbose digit so neither branch can ever
	# return non-zero and trip `set -e` at the call site.
	case "${_rdrc_verbose:-0}" in
	[2-9]|[1-9][0-9]*)
		echo "$@"
		;;
	esac
}

rdrcv "RDRC: ENTER ramdisk rc, arch=`sysenv arch 2>&1`"

if [ X`sysenv arch` = Xi386 ]
then	if [ -e $ACPI -a -n "`sysenv acpi`" ]
	then
		minix-service -c up $ACPI
	fi
	minix-service -c up /service/pci -dev /dev/pci

	minix-service -c up /service/input -dev /dev/kbdmux
	minix-service -c up /service/pckbd || :

	# Start procfs so we can access /proc/pci
	mount -t procfs none /proc >/dev/null

	# Do we want to use the virtio block device?
	# If not specified, default to yes if the device is found.
	if sysenv virtio_blk >/dev/null
	then	virtio_blk="`sysenv virtio_blk`"
        elif	grep '^[^ ]* [^ ]* 1AF4:1001[^ ]* ' /proc/pci >/dev/null
	then	echo "virtio_blk not set, defaulting to using found virtio device."
		virtio_blk=yes
        fi

	# Auto-detect an AHCI/SATA controller (PCI base/sub/prog-if class
	# 01/06/01, shown as "1/6/1/..." in /proc/pci) so a single boot entry
	# works on both q35 (AHCI) and i440fx/-machine pc (legacy IDE) without an
	# explicit ahci= boot option.  An explicit ahci=yes/no still wins.
	# `sysenv ahci` exits non-zero when the ahci env var is unset (the
	# auto-detect default).  Guard it so `set -e` doesn't abort rc here
	# (same gotcha as `sysenv verbose` above); empty means "probe below".
	ahci_opt="`sysenv ahci 2>/dev/null || true`"
	if [ -z "$ahci_opt" ] && grep -E '^[^ ]+ 1/6/1/' /proc/pci >/dev/null 2>&1
	then	ahci_opt=yes
	fi

	minix-service -cn up /service/floppy -dev /dev/fd0
	if [ X"$ahci_opt" = Xyes ] && [ -x /service/ahci ]
	then
		minix-service -c up /service/ahci -dev /dev/c0d0 -label ahci_0 -args instance=0
	elif [ X"$virtio_blk" = Xyes ]
	then
		minix-service -c up /service/virtio_blk -dev /dev/c0d0 -label virtio_blk_0 -args instance=0
	else
		minix-service -c up /service/at_wini -dev /dev/c0d0 -label at_wini_0
		minix-service -cr up /service/at_wini -dev /dev/c1d0 -label at_wini_1 -args instance=1 2>/dev/null || :
	fi
	umount /proc >/dev/null
fi

if [ X`sysenv arch` = Xearm ]
then	echo Starting the mmc driver
	minix-service -c up /service/mmc -dev /dev/c0d0
fi

if [ X`sysenv arch` = Xamd64 ]
then	rdrcv "RDRC: amd64 branch entered"
	# amd64 ramdisk: start what's available.  No legacy IDE/floppy yet.
	# Start ACPI before PCI so PCI's APIC-mode init can resolve the
	# 'acpi' DS label (otherwise pci panics with "Cannot use APIC mode
	# without ACPI!").  Required in APIC mode; harmless in PIC mode.
	rdrcv "RDRC: pre-ACPI; ACPI=$ACPI sysenv-acpi=[`sysenv acpi`]"
	if [ -e $ACPI ]
	then	minix-service -c up $ACPI && rdrcv "RDRC: ACPI started" \
			|| rdrcv "RDRC: ACPI start FAILED"
	else
		rdrcv "RDRC: ACPI binary not in ramdisk ($ACPI missing)"
	fi
	rdrcv "RDRC: starting PCI"
	minix-service -c up /service/pci -dev /dev/pci
	rdrcv "RDRC: starting input"
	minix-service -c up /service/input -dev /dev/kbdmux
	rdrcv "RDRC: starting pckbd"
	minix-service -c up /service/pckbd || :
	rdrcv "RDRC: pckbd done"

	# Start procfs so we can access /proc/pci for virtio detection.
	mount -t procfs none /proc >/dev/null

	if sysenv virtio_blk >/dev/null
	then	virtio_blk="`sysenv virtio_blk`"
	elif	grep '^[^ ]* [^ ]* 1AF4:1001[^ ]* ' /proc/pci >/dev/null 2>&1
	then	virtio_blk=yes
	fi

	# Auto-detect an AHCI/SATA controller (PCI base/sub/prog-if class
	# 01/06/01, shown as "1/6/1/..." in /proc/pci) and prefer it when present
	# (q35/UEFI); otherwise fall back to legacy IDE (i440fx/-machine pc, whose
	# default -cdrom hangs off the PIIX3 IDE controller).  An explicit
	# ahci=yes/no boot option overrides the probe.
	# `sysenv ahci` exits non-zero when the ahci env var is unset (the
	# auto-detect default).  Guard it so `set -e` doesn't abort rc here
	# (same gotcha as `sysenv verbose` above); empty means "probe below".
	ahci_opt="`sysenv ahci 2>/dev/null || true`"
	if [ -z "$ahci_opt" ] && grep -E '^[^ ]+ 1/6/1/' /proc/pci >/dev/null 2>&1
	then	ahci_opt=yes
	fi

	# Auto-detect an NVMe controller (PCI class 01/08/02, "1/8/2/..." in
	# /proc/pci).  An explicit nvme=yes/no boot option overrides the probe
	# (same guarding as ahci above).
	nvme_opt="`sysenv nvme 2>/dev/null || true`"
	if [ -z "$nvme_opt" ] && grep -E '^[^ ]+ 1/8/2/' /proc/pci >/dev/null 2>&1
	then	nvme_opt=yes
	fi

	# When booting from CD the boot medium is on the CD controller (AHCI/IDE),
	# which must be c0d0 for cdprobe to find it -- so NVMe only becomes the
	# primary disk (c0d0) for a non-CD (installed) boot; during CD boot it is
	# brought up as a secondary disk (c1d0) instead.
	if [ X"$nvme_opt" = Xyes ] && sysenv cdproberoot >/dev/null
	then	nvme_primary=no
	else	nvme_primary="$nvme_opt"
	fi

	# The disk that holds the root is not necessarily the highest-priority
	# controller present: a system may have an IDE/AHCI root alongside a
	# blank or foreign NVMe data disk.  When rootdevname names a partition on
	# c0d0, verify that the controller we bring up as c0d0 actually carries
	# that root before committing to it; if it does not, tear it down and try
	# the next candidate.  This keeps the modern-first preference while
	# avoiding an unbootable system when a higher-priority controller is
	# present but is not the boot disk.  The check reads the super block with
	# fsck_mfs -- the same MFS assumption the root fsck below already makes;
	# it fails fast on a blank/foreign disk and passes on a valid root whether
	# clean or dirty.  (Identifying the root by content/UUID rather than by
	# device number would also disambiguate a foreign-but-valid MFS data disk;
	# that is left as future work.)
	root_probe=
	case "`sysenv rootdevname 2>/dev/null || true`" in
	c0d0*)	root_probe="/dev/`sysenv rootdevname`" ;;
	esac

	# Does the disk currently at c0d0 carry the configured root?  Succeeds
	# when there is nothing to verify against (CD/ramdisk boot, or a root not
	# on c0d0), so those paths keep their existing behaviour.
	c0d0_has_root() {
		[ -n "$root_probe" ] || return 0
		$FSCK -p "$root_probe" >/dev/null 2>&1
	}

	# Bring a controller up as the primary disk c0d0; if it does not carry
	# the root, tear it back down and fail so the caller can try the next.
	try_primary() {	# service label [extra args...]
		_svc="$1"; _lbl="$2"; shift 2
		[ -x "$_svc" ] || return 1
		minix-service -c up "$_svc" -dev /dev/c0d0 -label "$_lbl" "$@" \
			2>/dev/null || return 1
		if c0d0_has_root
		then	return 0
		fi
		minix-service down "$_lbl" >/dev/null 2>&1 || :
		return 1
	}

	# Choose the primary disk (c0d0), preferring modern controllers (NVMe,
	# AHCI, virtio) over legacy IDE, falling through when the chosen disk does
	# not hold the root.  Legacy IDE is the last resort: bring it up
	# unconditionally and let the root fsck/mount below be authoritative,
	# since there is no further fallback to probe for.
	primary_up=no
	nvme_is_primary=no

	if [ X"$primary_up" = Xno ] && [ X"$nvme_primary" = Xyes ] && \
	   try_primary /service/nvme nvme_0 -args instance=0
	then	primary_up=yes; nvme_is_primary=yes
	fi
	if [ X"$primary_up" = Xno ] && [ X"$ahci_opt" = Xyes ] && \
	   try_primary /service/ahci ahci_0 -args instance=0
	then	primary_up=yes
	fi
	if [ X"$primary_up" = Xno ] && [ X"$virtio_blk" = Xyes ] && \
	   try_primary /service/virtio_blk virtio_blk_0 -args instance=0
	then	primary_up=yes
	fi
	if [ X"$primary_up" = Xno ] && [ -x /service/at_wini ]
	then
		minix-service -c up /service/at_wini -dev /dev/c0d0 -label at_wini_0
		minix-service -cr up /service/at_wini -dev /dev/c1d0 -label at_wini_1 -args instance=1 2>/dev/null || :
		primary_up=yes
	fi

	# If NVMe is present but did not become the primary disk (CD boot,
	# demoted in favour of the real root disk, or another controller won
	# c0d0), expose it as a secondary disk.
	if [ X"$nvme_opt" = Xyes ] && [ X"$nvme_is_primary" = Xno ] && [ -x /service/nvme ]
	then	minix-service -cr up /service/nvme -dev /dev/c1d0 -label nvme_0 -args instance=0 2>/dev/null || :
	fi
	umount /proc >/dev/null
fi

# Load ProcFS from the ramdisk to minimize the chance of a desync with the boot
# image services from which it obtains data structures directly.  As we move to
# the MIB service, this will eventually become obsolete.
minix-service up /service/procfs || echo "WARNING: couldn't start procfs"

if sysenv rootdevname >/dev/null
then	rootdevname=/dev/`sysenv rootdevname`
else
	if ! sysenv cdproberoot >/dev/null && ! sysenv bootramdisk >/dev/null
	then	echo "rootdevname not set"
		exit 1
	fi
fi

if [ "`sysenv bin_img`" = 1 ]
then
    bin_img="-i "
fi

if sysenv cdproberoot >/dev/null
then
	echo
	echo 'Looking for boot CD. This may take a minute.'
	echo 'Please ignore any error messages.'
	echo
	rootdevname=$(cdprobe) || { echo 'No CD found'; exit 1; }
	export rootdevname
elif [ "$rootdevname" = "/dev/ram" ]
then
	ramimagename=/dev/`sysenv ramimagename`
	echo "Loading ramdisk from $ramimagename"
	loadramdisk "$ramimagename" || echo "WARNING: loadramdisk failed"
fi

if sysenv bootramdisk >/dev/null
then
	rootdevname=imgrd
fi

echo "Root device name is $rootdevname"

if ! sysenv cdproberoot >/dev/null
then
	if [ -e $FSCK ]
	then	$FSCK -p $rootdevname
	fi
fi

# Change root from temporary boot ramdisk to the configure root device
if ! sysenv bootramdisk >/dev/null; then
	mount -n $bin_img"$rootdevname" /

	# Reopen standard file descriptors, so that we can unmount the ramdisk.
	# That is essentially a VFS shortcoming that should be fixed, though..
	exec >/dev/log
	exec 2>/dev/log
	exec </dev/console
fi

# Mount the ProcFS instance that was loaded from the ramdisk, on the root FS.
mount -e -n -t procfs none /proc || echo "WARNING: couldn't mount procfs"

# Start the NetBSD rc infrastructure
if ! sysenv bootramdisk >/dev/null; then
	exec sh /etc/rc "$@"
fi
